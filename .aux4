{
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "build",
          "execute": [
            "cd package/lib && npm install --omit=dev --no-audit --no-fund",
            "rm -rf package/lib/node_modules/onnxruntime-web",
            "find package/lib/node_modules/onnxruntime-node/bin -name 'DirectML.dll' -delete",
            "find package/lib/node_modules/onnxruntime-node/bin -name 'dxil.dll' -delete",
            "find package/lib/node_modules/onnxruntime-node/bin -name 'dxcompiler.dll' -delete"
          ],
          "help": {
            "text": "Dev convenience only: pre-install the aux4/embedding runtime deps locally (the published package does NOT ship node_modules - this is installed lazily on the user's machine on first use, see package/lib/embed.mjs)"
          }
        }
      ]
    }
  ]
}
